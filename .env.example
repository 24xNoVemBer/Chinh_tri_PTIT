PORT=3001
HOST=127.0.0.1
DATABASE_PATH=data/ptit-teaching-assistant.sqlite
NODE_ENV=development
VITE_DATA_SOURCE=api
RAG_DEMO_DATA=true

# Origin được phép gửi request thay đổi dữ liệu (chặn CSRF).
# Phân tách nhiều origin bằng dấu phẩy, ghi đủ scheme, không có dấu / ở cuối.
#   TRUSTED_ORIGINS=https://chinhtri.ptit.edu.vn,https://www.chinhtri.ptit.edu.vn
# Ở chế độ development có thể để trống: mọi origin loopback (localhost, 127.0.0.1) đều được
# tin cậy để dev server Vite proxy được sang API.
# BẮT BUỘC khi NODE_ENV=production — server sẽ từ chối khởi động nếu thiếu.
TRUSTED_ORIGINS=

# Chỉ đặt true nếu thực sự muốn tạo 7 tài khoản demo (mật khẩu công khai trong README)
# trên một deployment production. Bình thường phải để trống.
SEED_DEMO_DATA=
