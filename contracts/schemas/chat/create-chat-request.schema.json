{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ptit-chinh-tri.local/schemas/chat/create-chat-request.schema.json",
  "title": "CreateChatRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "tenantId",
    "query",
    "conversation",
    "scope",
    "policy",
    "limits",
    "client"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requestId": { "type": "string", "format": "uuid" },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "language"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }
      }
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversationId", "messageId", "history"],
      "properties": {
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "messageId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "history": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "text"],
            "properties": {
              "role": { "enum": ["user", "assistant"] },
              "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectId", "classIds", "lessonId", "allowedMaterialVersionIds"],
      "properties": {
        "subjectId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "classIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "lessonId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "allowedMaterialVersionIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicationMode", "citationRequired", "maxOutputTokens", "safetyPolicyVersion"],
      "properties": {
        "publicationMode": { "enum": ["provisional", "published_only"] },
        "citationRequired": { "type": "boolean" },
        "maxOutputTokens": { "type": "integer", "minimum": 64, "maximum": 4096 },
        "safetyPolicyVersion": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadlineMs", "maxRetrievedChunks", "maxContextTokens"],
      "properties": {
        "deadlineMs": { "type": "integer", "minimum": 100, "maximum": 120000 },
        "maxRetrievedChunks": { "type": "integer", "minimum": 1, "maximum": 50 },
        "maxContextTokens": { "type": "integer", "minimum": 256, "maximum": 32768 }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    }
  }
}
